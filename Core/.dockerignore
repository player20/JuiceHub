# Ignore node modules directories
**/node_modules

# Ignore distribution directories (lib for backwards compatibility)
**/dist
**/lib

# Common ignore files
.gitignore
**/package-lock.json

# Specific files and file types to ignore
**/*.js
**/*.cjs
**/*.md
**/*.yml
**/*.tsbuildinfo
**/*.log
**/*.tgz
**/*.Dockerfile

# Specific directories to ignore
**/DirectusExtensions
**/Swarm
**/data

# include sequelize bridge and build scripts
!Server/
!Server/src/
!Server/src/config/
!Server/src/config/sequelize.bridge.config.js
!Server/copy-assets.js
!build.mjs
!db.force-sync.js
!db.force-sync.ts
!db.sync.ts
