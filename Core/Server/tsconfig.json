    {
      "path": "../03_Modules/Configuration"
    },
    {
      "path": "../03_Modules/EVDriver"
    },
    {
      "path": "../03_Modules/Monitoring"
    },
    {
      "path": "../03_Modules/OcppRouter"
    },
    {
      "path": "../03_Modules/Reporting"
    },
    {
      "path": "../03_Modules/SmartCharging"
    },
    {
      "path": "../03_Modules/Transactions"
    }
  ]
}
