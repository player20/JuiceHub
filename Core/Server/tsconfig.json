{
  "extends": "../tsconfig.build.json",
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.*.ts",
    "**/*.example.ts",
    "**/__tests__/**",
    "src/middleware/multiTenancy.integration.example.ts",
    "src/routes/admin/tenants.example.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
