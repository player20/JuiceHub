# CitrineOS Multi-Tenancy Configuration
# Copy this to your .env file and fill in the values

# ============================================================================
# REDIS CONFIGURATION (Required for Rate Limiting)
# ============================================================================

# Redis host (use 'localhost' for local development, or service name for Docker)
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number (0-15, default: 0)
REDIS_DB=0

# Redis connection URL (alternative to individual settings)
# REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT CONFIGURATION (Required for Tenant Identification)
# ============================================================================

# Secret key for JWT token verification
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-change-this-in-production

# JWT token expiration (e.g., '1h', '7d', '30d')
JWT_EXPIRES_IN=7d

# ============================================================================
# MULTI-TENANCY SETTINGS
# ============================================================================

# Default subscription tier for new tenants
DEFAULT_SUBSCRIPTION_TIER=free

# Enable automatic trial for new signups
ENABLE_FREE_TRIAL=true

# Trial duration in days
TRIAL_DURATION_DAYS=30

# ============================================================================
# BILLING & PAYMENTS (Stripe Integration)
# ============================================================================

# Stripe secret key (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe publishable key (for frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret (for webhook verification)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe product IDs for each tier
STRIPE_PRODUCT_FREE=prod_...
STRIPE_PRODUCT_STARTER=prod_...
STRIPE_PRODUCT_PROFESSIONAL=prod_...
STRIPE_PRODUCT_ENTERPRISE=prod_...

# Billing portal URL (where users can manage subscriptions)
BILLING_PORTAL_URL=https://app.citrineos.com/billing

# ============================================================================
# QUOTA DEFAULTS (Override per-tier defaults)
# ============================================================================

# Free Tier
FREE_MAX_STATIONS=5
FREE_MAX_API_CALLS_PER_HOUR=1000
FREE_MAX_STORAGE_GB=1
FREE_MAX_CONCURRENT_SESSIONS=10

# Starter Tier
STARTER_MAX_STATIONS=25
STARTER_MAX_API_CALLS_PER_HOUR=10000
STARTER_MAX_STORAGE_GB=10
STARTER_MAX_CONCURRENT_SESSIONS=50

# Professional Tier
PROFESSIONAL_MAX_STATIONS=100
PROFESSIONAL_MAX_API_CALLS_PER_HOUR=50000
PROFESSIONAL_MAX_STORAGE_GB=50
PROFESSIONAL_MAX_CONCURRENT_SESSIONS=200

# Enterprise Tier
ENTERPRISE_MAX_STATIONS=99999
ENTERPRISE_MAX_API_CALLS_PER_HOUR=999999
ENTERPRISE_MAX_STORAGE_GB=1000
ENTERPRISE_MAX_CONCURRENT_SESSIONS=10000

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Anonymous IP rate limit (requests per minute)
IP_RATE_LIMIT_PER_MINUTE=100

# Enable rate limit bypass for localhost (development)
RATE_LIMIT_SKIP_LOCALHOST=true

# Rate limit failure mode (fail-open or fail-closed)
# fail-open: Allow requests if Redis is down
# fail-closed: Block requests if Redis is down
RATE_LIMIT_FAILURE_MODE=fail-open

# ============================================================================
# DEPLOYMENT STRATEGY SETTINGS
# ============================================================================

# Default deployment strategy for new tenants
# Options: shared, dedicated-db, dedicated-infra
DEFAULT_DEPLOYMENT_STRATEGY=shared

# Enable automatic database provisioning for dedicated-db strategy
ENABLE_AUTO_DB_PROVISIONING=false

# Database host for dedicated databases (if using dedicated-db strategy)
DEDICATED_DB_HOST=dedicated-db.citrineos.com

# ============================================================================
# AWS CONFIGURATION (For Secrets Manager, S3, etc.)
# ============================================================================

# AWS region
AWS_REGION=us-east-1

# AWS access credentials (use IAM roles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for file storage
AWS_S3_BUCKET=citrineos-files

# Secrets Manager prefix for tenant credentials
AWS_SECRETS_PREFIX=citrineos

# ============================================================================
# DATABASE CONFIGURATION (Main Application Database)
# ============================================================================

# Database host
DATABASE_HOST=localhost

# Database port
DATABASE_PORT=5432

# Database name
DATABASE_NAME=citrine

# Database user
DATABASE_USER=citrine

# Database password
DATABASE_PASSWORD=your-password-here

# Enable connection pooling
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2

# ============================================================================
# MESSAGE BROKER (RabbitMQ)
# ============================================================================

# RabbitMQ connection URL
RABBITMQ_URL=amqp://localhost:5672

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Enable Prometheus metrics
ENABLE_METRICS=true

# Metrics port
METRICS_PORT=9090

# Enable distributed tracing (Jaeger)
ENABLE_TRACING=false

# Jaeger agent host
JAEGER_AGENT_HOST=localhost

# Jaeger agent port
JAEGER_AGENT_PORT=6831

# ============================================================================
# EMAIL NOTIFICATIONS (SendGrid, AWS SES, etc.)
# ============================================================================

# Email provider (sendgrid, ses, smtp)
EMAIL_PROVIDER=sendgrid

# SendGrid API key
SENDGRID_API_KEY=SG...

# From email address
EMAIL_FROM=noreply@citrineos.com

# From name
EMAIL_FROM_NAME=CitrineOS

# Enable welcome emails for new tenants
ENABLE_WELCOME_EMAIL=true

# Enable quota warning emails
ENABLE_QUOTA_WARNING_EMAIL=true

# Quota warning threshold (percentage)
QUOTA_WARNING_THRESHOLD=90

# ============================================================================
# SECURITY
# ============================================================================

# Enable HTTPS redirect
ENABLE_HTTPS_REDIRECT=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable helmet security headers
ENABLE_HELMET=true

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# ============================================================================
# LOGGING
# ============================================================================

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info

# Enable structured logging (JSON format)
ENABLE_STRUCTURED_LOGGING=true

# Log tenant ID in all logs
LOG_TENANT_ID=true

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Enable debug mode
DEBUG=false

# Seed database with test tenants
SEED_TEST_TENANTS=false

# Test tenant credentials
TEST_TENANT_EMAIL=test@example.com
TEST_TENANT_PASSWORD=testpassword123

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Analytics module by default for new tenants
DEFAULT_FEATURE_ANALYTICS=false

# Enable Revenue module by default for new tenants
DEFAULT_FEATURE_REVENUE=false

# Enable Alerts module by default for new tenants
DEFAULT_FEATURE_ALERTS=true

# Enable Smart Charging by default for new tenants
DEFAULT_FEATURE_SMART_CHARGING=false

# Enable V2G (Vehicle-to-Grid) by default for new tenants
DEFAULT_FEATURE_V2G=false

# ============================================================================
# ADMIN SETTINGS
# ============================================================================

# Admin dashboard URL
ADMIN_DASHBOARD_URL=https://admin.citrineos.com

# Enable admin API
ENABLE_ADMIN_API=true

# Admin API key (for programmatic access)
ADMIN_API_KEY=your-admin-api-key-here

# ============================================================================
# WEBHOOKS
# ============================================================================

# Webhook secret for tenant event notifications
WEBHOOK_SECRET=your-webhook-secret-here

# Webhook retry attempts
WEBHOOK_RETRY_ATTEMPTS=3

# Webhook timeout (milliseconds)
WEBHOOK_TIMEOUT=5000
