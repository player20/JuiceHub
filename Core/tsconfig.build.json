{
  "exclude": [
    "**/*.test.ts",
    "**/*.stub.ts",
    "**/*.example.ts",
    "./node_modules",
    "**/__tests__/*",
    "**/test/**",
    "./dist",
    "./**/dist",
    "./**/**/dist",
    "./migrations/**",
    "./db.sync.ts",
    "./db.force-sync.ts",
    "./jest.config.ts",
    "./DirectusExtensions/**",
    "./Swarm/**"
  ],
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "module": "commonjs",
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "references": [
    {
      "path": "./Server"
    }
  ]
}
