{
  "exclude": [
    "**/*.test.ts",
    "**/*.test.*.ts",
    "**/*.stub.ts",
    "**/*.example.ts",
    "./node_modules",
    "**/__tests__/**",
    "**/test/**",
    "./dist",
    "./**/dist",
    "./**/**/dist",
    "./migrations/**",
    "./db.sync.ts",
    "./db.force-sync.ts",
    "**/jest.config.ts",
    "./DirectusExtensions/**",
    "./Swarm/**",
    "./03_Modules/Alerts/**",
    "./03_Modules/Analytics/**",
    "./03_Modules/Certificates/**",
    "./03_Modules/Revenue/**",
    "./03_Modules/Tenant/**",
    "./02_Util/src/certificate/CertificateAuthority.ts",
    "./02_Util/src/certificate/CertificateUtil.ts",
    "./02_Util/src/export/ExportService.ts",
    "./02_Util/src/middleware/rateLimiter.ts",
    "./02_Util/src/middleware/tenantContext.ts",
    "./02_Util/src/services/QuotaEnforcementService.ts"
  ],
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "module": "commonjs",
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "noEmitOnError": false,
    "noImplicitAny": false
  },
  "references": [
    {
      "path": "./Server"
    }
  ]
}
