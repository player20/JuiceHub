# CitrineOS Operator UI Configuration
# ADA Accessible Interface

# Google Maps (REQUIRED - Get key from Google Cloud Console)
# ⚠️ IMPORTANT: The previous API key was exposed in git history and must be rotated
# Generate new key at: https://console.cloud.google.com/apis/credentials
# Add domain restriction: juicehub-ui.onrender.com/*
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Hasura GraphQL
VITE_HASURA_ADMIN_SECRET=your_hasura_admin_secret_here
VITE_API_URL=https://juicehub-hasura.onrender.com/v1/graphql
VITE_WS_URL=wss://juicehub-hasura.onrender.com/v1/graphql

# Core API
VITE_CITRINE_CORE_URL=https://juicehub-core.onrender.com
VITE_FILE_SERVER_URL=http://localhost:8050

# Application Branding
VITE_APP_NAME=JuiceNet
VITE_LOGO_URL=/juicenet-icon.png

# Development Authentication (Fallback)
# ⚠️ Only for local development - use Keycloak in production
VITE_ADMIN_EMAIL=admin@citrineos.local
VITE_ADMIN_PASSWORD=change_me_in_production

# Production Authentication (Keycloak)
# Uncomment and configure for production deployment
# VITE_KEYCLOAK_URL=https://your-keycloak-server.com
# VITE_KEYCLOAK_REALM=your-realm

# Local Development Override (optional)
# VITE_API_URL=http://localhost:8090/v1/graphql
# VITE_WS_URL=ws://localhost:8090/v1/graphql
# VITE_CITRINE_CORE_URL=http://localhost:8080
